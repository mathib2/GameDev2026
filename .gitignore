# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp

# Build output
build/
dist/
bin/
obj/
*.tmp

# Dependencies
node_modules/

# The asset generators under tools/ are Python; their bytecode cache is not
# content. The scripts themselves ARE committed — the art is reproducible.
__pycache__/
*.pyc

# ── Godot 4 ──────────────────────────────────────────────────────────────
# Generated; committing it causes constant meaningless merge conflicts.
.godot/
.import/
*.translation
.mono/
mono_crash.*.json

# NOTE: per-asset `<file>.png.import` settings sit BESIDE the asset and are NOT
# covered by `.import/` above. They MUST be committed so everyone imports
# identically. Do not add `*.import` here.
#
# export_presets.cfg IS committed on purpose: it defines the Windows build and
# contains no credentials. If anyone adds signing/store keys to it, move those
# to a local override instead.

# Build artefacts (the exported .exe is ~109 MB — never commit it)
STUFFED-Windows/
EnterTheStrongest-Windows/
*.pck
*.exe

# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.template
*.pem
*.key
*.keystore
*.p12

# Windows download markers that ride along when files are copied into WSL
*Zone.Identifier
