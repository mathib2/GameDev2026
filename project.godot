; Rogue Protocol — Godot 4.x project configuration
;
; Autoloads are the game's core systems. They are deliberately thin: they hold
; state and route events, and they never contain content. Content lives in
; res://data as Resources. See docs/architecture.md.

config_version=5

[application]

config/name="Rogue Protocol"
config/description="A 2D cyberpunk RPG where an absurdly skilled hacker solves trivial problems with military-grade cybersecurity."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameState="*res://scripts/core/game_state.gd"
ContentDB="*res://scripts/core/content_db.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
DialogueManager="*res://scripts/dialogue/dialogue_manager.gd"
InventoryManager="*res://scripts/inventory/inventory_manager.gd"
MissionManager="*res://scripts/missions/mission_manager.gd"
HackManager="*res://scripts/hacking/hack_manager.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
SaveManager="*res://scripts/save/save_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

