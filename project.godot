; STUFFED — Godot 4.x project configuration
;
; Autoloads are thin systems. Content lives in res://data as Resources.
; See docs/ARCHITECTURE.md.

config_version=5

[application]

config/name="STUFFED"
config/description="A very large man fights an army of toys."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameState="*res://scripts/core/game_state.gd"
ContentDB="*res://scripts/core/content_db.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
GameFeel="*res://scripts/core/game_feel.gd"
Effects="*res://scripts/core/effects.gd"
RunManager="*res://scripts/core/run_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=384
window/size/window_width_override=1280
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

