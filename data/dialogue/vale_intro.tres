[sub_resource type="Resource" id="Resource_line_1"]
script = ExtResource("2_line")
speaker = "Vale"
portrait = ExtResource("4_portrait")
text = "I have a contract. Client wants the wheel improved. The wheel. The round one.

Think you can reinvent it?"
